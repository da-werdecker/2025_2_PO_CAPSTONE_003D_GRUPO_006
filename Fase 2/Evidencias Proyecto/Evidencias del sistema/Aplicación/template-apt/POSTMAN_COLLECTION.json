							"raw": "http://localhost:3001/api/send-email",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3001",
							"path": [
								"api",
								"send-email"
							]
						},
						"description": "Endpoint para enviar correos electrónicos usando MailerSend"
					},
					"response": []
				}
			],
			"description": "Endpoints del servidor Express.js para servicios de email"
		},
		{
			"name": "Supabase API - Autenticación",
			"item": [
				{
					"name": "Obtener Token de Autenticación",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "apikey",
								"value": "{{SUPABASE_ANON_KEY}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario@ejemplo.com\",\n  \"password\": \"contraseña123\"\n}"
						},
						"url": {
							"raw": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
							"host": [
								"{{SUPABASE_URL}}"
							],
							"path": [
								"auth",
								"v1",
								"token"
							],
							"query": [
								{
									"key": "grant_type",
									"value": "password"
								}
							]
						},
						"description": "Obtener token de autenticación de Supabase (si se usa autenticación nativa)"
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticación de Supabase"
		},
