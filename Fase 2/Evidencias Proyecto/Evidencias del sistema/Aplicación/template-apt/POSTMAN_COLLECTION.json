							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"usuario@ejemplo.com\",\n  \"subject\": \"Prueba de Email - APT System\",\n  \"html\": \"<h1>Prueba de Email</h1><p>Este es un correo de prueba del sistema APT.</p>\"\n}"
						},
